{
  "version": 4,
  "targets": [],
  "approval_ref": null,
  "deny": [
    "rm ** {/,/bin,/sbin,/boot,/dev,/etc,/home,/lib,/lib64,/proc,/root,/run,/sys,/usr,/var,/bin/,/sbin/,/boot/,/dev/,/etc/,/home/,/lib/,/lib64/,/proc/,/root/,/run/,/sys/,/usr/,/var/} **",
    "ssh ** -o {StrictHostKeyChecking=no,StrictHostKeyChecking=off,StrictHostKeyChecking=false,StrictHostKeyChecking=0} **",
    "ssh ** {-oStrictHostKeyChecking=no,-oStrictHostKeyChecking=off,-oStrictHostKeyChecking=false,-oStrictHostKeyChecking=0} **",
    "ssh ** -o '{StrictHostKeyChecking no,StrictHostKeyChecking off,StrictHostKeyChecking false,StrictHostKeyChecking 0}' **"
  ],
  "scenarios": [
    {
      "name": "docker",
      "prefix": "docker --host unix:///var/run/docker.sock",
      "default": "allow",
      "ask": [
        "{debug,init,run,create,exec,attach,cp,build,pull,push,load,import,export,save,commit,restart,start,stop,kill,rm,rmi,prune,login,logout,rename,update,pause,unpause,wait,tag} **",
        "{container,image,service,stack,volume,network,node,swarm,secret,config,context,plugin,system} {create,update,rm,remove,prune} **",
        "container {run,exec,attach,cp,export,commit,restart,start,stop,kill,rename,pause,unpause,wait} **",
        "service {rollback,scale} **",
        "stack {deploy,up,down} **",
        "image {build,pull,push,load,import,save,tag} **",
        "network {connect,disconnect} **",
        "node {promote,demote} **",
        "swarm {init,join,leave,unlock,unlock-key,ca,join-token} **",
        "context {use,export,import} **",
        "plugin {install,enable,disable,upgrade,set,push} **",
        "config inspect **",
        "{compose,buildx,builder,checkpoint} **",
        "** {--host,--host=*,-H,-H?*,--context,--context=*,-c,-c?*,--config,--config=*,--tls,--tls=*,--tlsverify,--tlsverify=*,--tlscacert,--tlscacert=*,--tlscert,--tlscert=*,--tlskey,--tlskey=*} **",
        "** {--format,-f} {*Env*,*Args*,*Cmd*,*Data*,*Command*} **",
        "** {--format=*Env*,--format=*Args*,--format=*Cmd*,--format=*Data*,--format=*Command*,-f?*Env*,-f?*Args*,-f?*Cmd*,-f?*Data*,-f?*Command*} **",
        "logs ** {--follow,--follow=*,-*f*,--details,--details=*} **",
        "{container,service} logs ** {--follow,--follow=*,-*f*,--details,--details=*} **",
        "stats ** {--no-stream=false,--no-stream=0,--no-stream=f,--no-stream=FALSE} **",
        "container stats ** {--no-stream=false,--no-stream=0,--no-stream=f,--no-stream=FALSE} **",
        "inspect ** --type config **",
        "inspect ** --type=config **"
      ]
    },
    {
      "name": "general",
      "prefix": "",
      "default": "ask",
      "allow": [
        "id **",
        "whoami **",
        "groups **",
        "pwd **",
        "uname **",
        "uptime **",
        "nproc **",
        "hostname",
        "hostname -f",
        "hostname -I",
        "date",
        "date -u",
        "timedatectl show --property=Timezone,NTPSynchronized",
        "cat /etc/os-release",
        "cat /etc/issue",
        "cat /proc/loadavg",
        "cat /proc/meminfo",
        "cat /proc/uptime",
        "getconf LONG_BIT",
        "df **",
        "free **",
        "vmstat 1 3",
        "vmstat 1 5",
        "ps -eo pid,ppid,user,comm",
        "ps -eo pid,ppid,user,comm,%cpu,%mem",
        "ps -p * -o pid,ppid,user,comm,%cpu,%mem",
        "pgrep -x *",
        "ls **",
        "stat **",
        "readlink **",
        "lsblk **",
        "test -e *",
        "test -f *",
        "test -d *",
        "test -r *",
        "test -w *",
        "test -x *",
        "mountpoint -- *",
        "findmnt --target * --output TARGET,SOURCE,FSTYPE,OPTIONS",
        "du -sh -- *",
        "du --summarize --human-readable -- *",
        "ip -brief address",
        "ip -brief link",
        "ip address show **",
        "ip addr show **",
        "ip link show **",
        "ip route show **",
        "ip rule show **",
        "ss -s",
        "ss -lnt",
        "ss -lnu",
        "ss -lntp",
        "ss -lnup",
        "journalctl -u * -n * --no-pager",
        "journalctl -u * --since * -n * --no-pager",
        "dpkg-query -W **",
        "rpm -q **",
        "rpm -qa",
        "apt-cache policy **",
        "git -C * rev-parse **",
        "git -C * status **",
        "systemctl is-active *",
        "systemctl is-enabled *",
        "systemctl is-failed *",
        "systemctl show * --no-pager --property=ActiveState,SubState,MainPID",
        "systemctl show * --no-pager --property=ActiveState,SubState,MainPID,User,Group,FragmentPath,NeedDaemonReload",
        "systemctl list-units --type=service --all --no-pager --no-legend",
        "systemctl list-unit-files --type=service --no-pager --no-legend",
        "systemctl list-timers --all --no-pager",
        "systemctl list-sockets --all --no-pager",
        "systemctl --failed --no-pager"
      ]
    }
  ]
}
